# IMA OpenAPI 凭证（从 ima 开放平台获取）
# 二选一命名均可；connect-server 启动时从本文件载入到 process.env
# 不要把真实密钥提交到 git

IMA_OPENAPI_CLIENTID=your_client_id_here
IMA_OPENAPI_APIKEY=your_api_key_here

# 兼容别名（与上面等价，可只配一组）
# IMA_CLIENT_ID=
# IMA_API_KEY=

# 可选：本地知识库根目录（默认桌面「华为赛题/华为PC知识库」）
# HW_LOCAL_KB=

# 可选：连接服务端口（默认 8787）
# HW_CONNECT_PORT=8787

# ---------- 大模型（小红书/朋友圈/公众号平台提示词模板注入依赖此项）----------
# 不配则回退 article-engine / 本地模板，used_platform_template=false
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-pro-32k
# USE_LLM_GENERATION=1
# USE_ARTICLE_ENGINE=1
