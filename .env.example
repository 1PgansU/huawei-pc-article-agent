# IMA OpenAPI 凭证（从 ima 客户端 Claw → 开放平台配置获取）
# 申请地址: https://ima.qq.com/openapi
# 注意：本文件不要提交到 git

IMA_OPENAPI_CLIENTID=your_client_id_here
IMA_OPENAPI_APIKEY=your_api_key_here

# 大模型 API（生成软文用，未配置时进入 mock 模式）
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-pro-32k
